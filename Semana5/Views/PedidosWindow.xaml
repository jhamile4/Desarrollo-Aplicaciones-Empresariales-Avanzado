<Window x:Class="Semana5.Views.PedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento de Pedidos" Height="650" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mantenimiento de Pedidos" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,10" Grid.Row="0"/>

        <UniformGrid Columns="3" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="ClienteID:"/>
                <TextBox x:Name="txtClienteID" Height="28" Margin="0,3,0,8"/>
                <TextBlock Text="EmpleadoID:"/>
                <TextBox x:Name="txtEmpleadoID" Height="28" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="10,0,10,0">
                <TextBlock Text="Fecha Pedido (aaaa-mm-dd):"/>
                <TextBox x:Name="txtFechaPedido" Height="28" Margin="0,3,0,8"/>
                <TextBlock Text="Fecha Requerida (aaaa-mm-dd):"/>
                <TextBox x:Name="txtFechaRequerida" Height="28" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="TransportistaID:"/>
                <TextBox x:Name="txtTransportistaID" Height="28" Margin="0,3,0,8"/>
                <TextBlock Text="Destinatario:"/>
                <TextBox x:Name="txtDestinatario" Height="28" Margin="0,3,0,0"/>
            </StackPanel>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Nuevo" Width="80" Height="30" Click="BtnNuevo_Click"/>
            <Button Content="Guardar" Width="80" Height="30" Margin="10,0,0,0" Click="BtnGuardar_Click"/>
            <Button Content="Eliminar" Width="80" Height="30" Margin="10,0,0,0" Click="BtnEliminar_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgPedidos" Grid.Row="3" AutoGenerateColumns="True"
                  IsReadOnly="True" SelectionChanged="DgPedidos_SelectionChanged" Height="150"/>

        <TextBlock Text="Reporte de Detalles por rango de fechas" FontSize="14" FontWeight="Bold"
                   Grid.Row="4" Margin="0,15,0,5"/>

        <StackPanel Orientation="Horizontal" Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Desde:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtDesde" Width="120" Height="28" Margin="5,0,0,0"/>
            <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtHasta" Width="120" Height="28" Margin="5,0,0,0"/>
            <Button Content="Generar Reporte" Width="120" Height="28" Margin="10,0,0,0" Click="BtnReporte_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgReporte" Grid.Row="6" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Window>