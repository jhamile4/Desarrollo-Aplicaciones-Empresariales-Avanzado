<Window x:Class="Semana5.Views.ProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mantenimiento de Proveedores" Height="550" Width="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Mantenimiento de Proveedores" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,10" Grid.Row="0"/>

        <UniformGrid Columns="2" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Compañía:"/>
                <TextBox x:Name="txtCompania" Height="28" Margin="0,3,0,8"/>
                <TextBlock Text="Nombre Contacto:"/>
                <TextBox x:Name="txtContacto" Height="28" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Ciudad:"/>
                <TextBox x:Name="txtCiudad" Height="28" Margin="0,3,0,8"/>
                <TextBlock Text="Teléfono:"/>
                <TextBox x:Name="txtTelefono" Height="28" Margin="0,3,0,0"/>
            </StackPanel>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Nuevo" Width="80" Height="30" Click="BtnNuevo_Click"/>
            <Button Content="Guardar" Width="80" Height="30" Margin="10,0,0,0" Click="BtnGuardar_Click"/>
            <Button Content="Eliminar" Width="80" Height="30" Margin="10,0,0,0" Click="BtnEliminar_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Buscar - Contacto:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtBuscarContacto" Width="150" Height="28" Margin="5,0,0,0"/>
            <TextBlock Text="Ciudad:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtBuscarCiudad" Width="150" Height="28" Margin="5,0,0,0"/>
            <Button Content="Buscar" Width="80" Height="28" Margin="10,0,0,0" Click="BtnBuscar_Click"/>
            <Button Content="Mostrar todos" Width="100" Height="28" Margin="10,0,0,0" Click="BtnMostrarTodos_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgProveedores" Grid.Row="4" AutoGenerateColumns="True"
                  IsReadOnly="True" SelectionChanged="DgProveedores_SelectionChanged"/>
    </Grid>
</Window>