<Window x:Class="Semana5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeptunoDB - Menú Principal" Height="350" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="30" VerticalAlignment="Center">
        <TextBlock Text="Menú Principal" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Button Content="Categorías" Height="35" Margin="0,5" Click="BtnCategorias_Click"/>
        <Button Content="Proveedores" Height="35" Margin="0,5" Click="BtnProveedores_Click"/>
        <Button Content="Productos" Height="35" Margin="0,5" Click="BtnProductos_Click"/>
        <Button Content="Pedidos" Height="35" Margin="0,5" Click="BtnPedidos_Click"/>
    </StackPanel>
</Window>