<Window x:Class="semana6.Views.ReportePedidosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Pedidos - Neptuno"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Reporte de Pedidos"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Consulta de pedidos por intervalo de fechas"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Desde:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="5,0,10,0"/>

                <DatePicker x:Name="dpFechaInicio"
                            Grid.Column="1"
                            Height="40"
                            VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="Hasta:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="20,0,10,0"/>

                <DatePicker x:Name="dpFechaFin"
                            Grid.Column="3"
                            Height="40"
                            VerticalContentAlignment="Center"/>

                <Button Grid.Column="5"
        Content="📊 Generar reporte"
        Style="{StaticResource ActionButton}"
        Background="#2563EB"
        Foreground="White"
        Width="180"
        Click="GenerarReporte_Click"/>

            </Grid>

        </Border>

        <!-- TABLA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="15">

            <DataGrid x:Name="dgReporte"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="42"
                      FontSize="13"
                      BorderThickness="0"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Pedido"
                                        Binding="{Binding PedidoID}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding FechaPedido, StringFormat={}{0:dd/MM/yyyy}}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Destinatario"
                                        Binding="{Binding Destinatario}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Ciudad"
                                        Binding="{Binding CiudadDestino}"
                                        Width="150"/>

                    <DataGridTextColumn Header="País"
                                        Binding="{Binding PaisDestino}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Producto"
                                        Binding="{Binding NombreProducto}"
                                        Width="200"/>

                    <DataGridTextColumn Header="Cantidad"
                                        Binding="{Binding Cantidad}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Precio"
                                        Binding="{Binding PrecioUnidad, StringFormat=C}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Descuento"
                                        Binding="{Binding Descuento}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>