<Window x:Class="semana6.Views.ProveedoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proveedores - Neptuno"
        Height="680"
        Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Proveedores"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Administración y búsqueda de proveedores"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- BARRA DE ACCIONES -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <TextBox x:Name="txtNombreContacto"
                             Width="220"
                             Height="40"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Padding="12"
                             Text="Nombre contacto..."/>

                    <TextBox x:Name="txtCiudad"
                             Width="180"
                             Height="40"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Padding="12"
                             Margin="10,0,0,0"
                             Text="Ciudad..."/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="🔍 Buscar"
                            Style="{StaticResource ActionButton}"
                            Background="#E8EEF9"
                            Foreground="#2563EB"/>

                    <Button Content="＋ Nuevo"
                            Style="{StaticResource ActionButton}"
                            Background="#2563EB"
                            Foreground="White"/>

                    <Button Content="✏ Editar"
                            Style="{StaticResource ActionButton}"
                            Background="#E8EEF9"
                            Foreground="#2563EB"/>

                    <Button Content="🗑 Desactivar"
                            Style="{StaticResource ActionButton}"
                            Background="#FEE2E2"
                            Foreground="#DC2626"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- TABLA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="15">

            <DataGrid x:Name="dgProveedores"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="42"
                      FontSize="13"
                      BorderThickness="0"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding ProveedorID}"
                                        Width="60"/>

                    <DataGridTextColumn Header="Empresa"
                                        Binding="{Binding CompaniaNombre}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Contacto"
                                        Binding="{Binding NombreContacto}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Cargo"
                                        Binding="{Binding CargoContacto}"
                                        Width="150"/>

                    <DataGridTextColumn Header="Ciudad"
                                        Binding="{Binding Ciudad}"
                                        Width="130"/>

                    <DataGridTextColumn Header="País"
                                        Binding="{Binding Pais}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Teléfono"
                                        Binding="{Binding Telefono}"
                                        Width="130"/>

                    <DataGridCheckBoxColumn Header="Activo"
                                            Binding="{Binding Activo}"
                                            Width="80"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>