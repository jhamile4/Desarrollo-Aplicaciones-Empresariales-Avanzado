<Window x:Class="semana6.Views.NuevoProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Producto"
        Height="600"
        Width="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Nuevo producto"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Ingresa los datos del producto"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Nombre:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtNombre"
                         Grid.Column="1"
                         Height="38"
                         Padding="10"/>

                <TextBlock Text="Proveedor ID:"
                           Grid.Row="1"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtProveedor"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="38"
                         Padding="10"/>

                <TextBlock Text="Categoría ID:"
                           Grid.Row="2"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtCategoria"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="38"
                         Padding="10"/>

                <TextBlock Text="Cantidad por unidad:"
                           Grid.Row="3"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtCantidad"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="38"
                         Padding="10"/>

                <TextBlock Text="Precio:"
                           Grid.Row="4"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtPrecio"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="38"
                         Padding="10"/>

                <TextBlock Text="Stock:"
                           Grid.Row="5"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="txtStock"
                         Grid.Row="5"
                         Grid.Column="1"
                         Height="38"
                         Padding="10"/>

            </Grid>

        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <Button Content="Cancelar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Background="#E5E7EB"
                    BorderThickness="0"
                    Click="Cancelar_Click"/>

            <Button Content="Guardar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Guardar_Click"/>

        </StackPanel>

    </Grid>

</Window>
