<Window x:Class="semana6.Views.CategoriasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Categorías - Neptuno"
        Height="650"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Categorías"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#1F2937"/>

            <TextBlock Text="Administración de categorías activas"
                       FontSize="14"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- BARRA DE ACCIONES -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtBuscar"
                         Width="300"
                         Height="40"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Padding="12"
                         Text="Buscar categoría..."/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Content="🔍 Buscar"
                            Style="{StaticResource ActionButton}"
                            Background="#E8EEF9"
                            Foreground="#2563EB"/>

                    <Button Content="＋ Nuevo"
                            Style="{StaticResource ActionButton}"
                            Background="#2563EB"
                            Foreground="White"/>

                    <Button Content="✏ Editar"
                            Style="{StaticResource ActionButton}"
                            Background="#E8EEF9"
                            Foreground="#2563EB"/>

                    <Button Content="🗑 Desactivar"
                            Style="{StaticResource ActionButton}"
                            Background="#FEE2E2"
                            Foreground="#DC2626"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- TABLA -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="15">

            <DataGrid x:Name="dgCategorias"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      RowHeight="42"
                      FontSize="13"
                      BorderThickness="0"
                      SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding CategoriaID}"
                                        Width="80"/>

                    <DataGridTextColumn Header="Nombre"
                                        Binding="{Binding NombreCategoria}"
                                        Width="250"/>

                    <DataGridTextColumn Header="Descripción"
                                        Binding="{Binding Descripcion}"
                                        Width="*"/>

                    <DataGridCheckBoxColumn Header="Activo"
                                            Binding="{Binding Activo}"
                                            Width="90"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>