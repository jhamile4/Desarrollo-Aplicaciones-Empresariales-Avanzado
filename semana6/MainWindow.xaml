<Window x:Class="semana6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neptuno - Sistema de Gestión"
        Height="720"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- Colores principales -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2563EB"/>
        <SolidColorBrush x:Key="DarkColor" Color="#172033"/>
        <SolidColorBrush x:Key="LightColor" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="TextColor" Color="#1F2937"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#6B7280"/>

        <!-- Botón lateral -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Tarjetas -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0"
                Background="{StaticResource DarkColor}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="25,0">

                    <TextBlock Text="NEPTUNO"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"/>

                    <TextBlock Text="Sistema de Gestión"
                               Foreground="#9CA3AF"
                               FontSize="12"
                               Margin="0,4,0,0"/>

                </StackPanel>

                <!-- MENU -->
                <StackPanel Grid.Row="1">

                    <TextBlock Text="MENÚ PRINCIPAL"
                               Foreground="#6B7280"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="25,15,0,8"/>

                    <Button Content="🏠   Inicio"
        Style="{StaticResource MenuButtonStyle}"
        Click="Inicio_Click"/>

                    <Button Content="📦   Productos"
        Style="{StaticResource MenuButtonStyle}"
        Click="Productos_Click"/>

                    <Button Content="🏷   Categorías"
        Style="{StaticResource MenuButtonStyle}"
        Click="Categorias_Click"/>

                    <Button Content="🚚   Proveedores"
        Style="{StaticResource MenuButtonStyle}"
        Click="Proveedores_Click"/>

                    <Button Content="🛒   Pedidos"
        Style="{StaticResource MenuButtonStyle}"
        Click="Pedidos_Click"/>

                    <TextBlock Text="REPORTES"
           Foreground="#6B7280"
           FontSize="11"
           FontWeight="Bold"
           Margin="25,25,0,8"/>

                    <Button Content="📊   Reporte de pedidos"
        Style="{StaticResource MenuButtonStyle}"
        Click="ReportePedidos_Click"/>
                </StackPanel>

                <!-- PIE -->
                <Border Grid.Row="2"
                        BorderBrush="#2D3748"
                        BorderThickness="0,1,0,0">

                    <StackPanel VerticalAlignment="Center"
                                Margin="25,0">

                        <TextBlock Text="Semana 06"
                                   Foreground="White"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="ADO.NET • WPF"
                                   Foreground="#6B7280"
                                   FontSize="11"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ================= CONTENIDO ================= -->
        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CABECERA -->
            <Grid Grid.Row="0">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Panel principal"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"/>

                    <TextBlock Text="Administra la información de Neptuno"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryText}"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="25"
                        Padding="15,8">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="👤"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text=" Administrador"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextColor}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- DASHBOARD -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- TARJETAS -->
                    <Grid Margin="0,10,0,20">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <!-- Productos -->
                        <Border Grid.Column="0"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="📦"
                                           FontSize="25"/>

                                <TextBlock Text="Productos"
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,12,0,3"/>

                                <TextBlock Text="Gestión"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextColor}"/>

                            </StackPanel>

                        </Border>

                        <!-- Categorías -->
                        <Border Grid.Column="1"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="🏷"
                                           FontSize="25"/>

                                <TextBlock Text="Categorías"
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,12,0,3"/>

                                <TextBlock Text="Gestión"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextColor}"/>

                            </StackPanel>

                        </Border>

                        <!-- Proveedores -->
                        <Border Grid.Column="2"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="🚚"
                                           FontSize="25"/>

                                <TextBlock Text="Proveedores"
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,12,0,3"/>

                                <TextBlock Text="Gestión"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextColor}"/>

                            </StackPanel>

                        </Border>

                        <!-- Pedidos -->
                        <Border Grid.Column="3"
                                Style="{StaticResource CardStyle}">

                            <StackPanel>

                                <TextBlock Text="🛒"
                                           FontSize="25"/>

                                <TextBlock Text="Pedidos"
                                           FontSize="14"
                                           Foreground="{StaticResource SecondaryText}"
                                           Margin="0,12,0,3"/>

                                <TextBlock Text="Gestión"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextColor}"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- BIENVENIDA -->
                    <Border Background="White"
                            CornerRadius="16"
                            Padding="30"
                            Margin="8">

                        <StackPanel>

                            <TextBlock Text="Bienvenido al sistema Neptuno 👋"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextColor}"/>

                            <TextBlock Text="Desde este panel podrás administrar productos, categorías, proveedores y pedidos."
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,25"/>

                            <TextBlock Text="Accesos rápidos"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextColor}"
                                       Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal">

                                <Button Content="📦  Productos"
        Width="160"
        Height="45"
        Margin="0,0,12,0"
        Background="{StaticResource PrimaryColor}"
        Foreground="White"
        BorderThickness="0"
        FontWeight="SemiBold"
        Click="Productos_Click"/>

                                <Button Content="🚚  Proveedores"
        Width="160"
        Height="45"
        Margin="0,0,12,0"
        Background="#E8EEF9"
        Foreground="{StaticResource PrimaryColor}"
        BorderThickness="0"
        FontWeight="SemiBold"
        Click="Proveedores_Click"/>

                                <Button Content="🛒  Pedidos"
        Width="160"
        Height="45"
        Margin="0,0,12,0"
        Background="#E8EEF9"
        Foreground="{StaticResource PrimaryColor}"
        BorderThickness="0"
        FontWeight="SemiBold"
        Click="Pedidos_Click"/>

                                <Button Content="📊  Reportes"
        Width="160"
        Height="45"
        Background="#E8EEF9"
        Foreground="{StaticResource PrimaryColor}"
        BorderThickness="0"
        FontWeight="SemiBold"
        Click="ReportePedidos_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- INFORMACIÓN -->
                    <Border Background="White"
                            CornerRadius="16"
                            Padding="25"
                            Margin="8,15,8,30">

                        <StackPanel>

                            <TextBlock Text="Módulos del sistema"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextColor}"/>

                            <TextBlock Text="La aplicación permite realizar operaciones de mantenimiento y consultas utilizando WPF, ADO.NET y SQL Server."
                                       FontSize="14"
                                       Foreground="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>
