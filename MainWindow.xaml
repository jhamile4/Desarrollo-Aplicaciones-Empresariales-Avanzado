<Window x:Class="Wpfseman2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Gestión"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LADO IZQUIERDO -->
        <Border Grid.Column="0"
                Background="#173F5F">

            <StackPanel VerticalAlignment="Center"
                        Margin="70">

                <TextBlock Text="GESTIÓN"
                           Foreground="White"
                           FontSize="42"
                           FontWeight="Bold"/>

                <TextBlock Text="EMPRESARIAL"
                           Foreground="#4FD1C5"
                           FontSize="42"
                           FontWeight="Bold"/>

                <TextBlock Text="Sistema de control y gestión"
                           Foreground="#D9E2EC"
                           FontSize="18"
                           Margin="0,20,0,0"/>

                <TextBlock Text="Administra ingresos, conductores y reportes desde un solo lugar."
                           Foreground="#D9E2EC"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Margin="0,10,20,0"/>
            </StackPanel>
        </Border>

        <!-- LADO DERECHO -->
        <Border Grid.Column="1"
                Background="White"
                Padding="60">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Bienvenido"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#173F5F"/>

                <TextBlock Text="Inicia sesión para continuar"
                           FontSize="14"
                           Foreground="#718096"
                           Margin="0,8,0,30"/>

                <TextBlock Text="Usuario"
                           FontWeight="SemiBold"
                           Foreground="#2D3748"/>

                <TextBox x:Name="txtUsuario"
                         Height="40"
                         Margin="0,8,0,20"
                         Padding="10"
                         FontSize="14"/>

                <TextBlock Text="Contraseña"
                           FontWeight="SemiBold"
                           Foreground="#2D3748"/>

                <PasswordBox x:Name="txtPassword"
                             Height="40"
                             Margin="0,8,0,25"
                             Padding="10"
                             FontSize="14"/>

                <Button x:Name="btnIngresar"
                        Content="INGRESAR"
                        Height="45"
                        Background="#4FD1C5"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnIngresar_Click"/>

                <TextBlock x:Name="txtMensaje"
                           Text=""
                           Foreground="#E53E3E"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,15,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

