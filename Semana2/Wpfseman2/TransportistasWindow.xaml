<Window x:Class="Wpfseman2.TransportistasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Transportistas"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Registro de Transportistas"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#173F5F"/>

            <TextBlock Text="Registra la información del transportista"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,30"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="30">

                <StackPanel>

                    <TextBlock Text="Nombre del Transportista"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtNombreTransportista"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="RUC"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtRuc"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="Teléfono"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtTelefono"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <Button x:Name="btnRegistrarTransportista"
                            Content="REGISTRAR TRANSPORTISTA"
                            Height="45"
                            Width="240"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Background="#4FD1C5"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnRegistrarTransportista_Click"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Window>