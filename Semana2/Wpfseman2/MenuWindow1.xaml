<Window x:Class="Wpfseman2.MenuWindow1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menú Principal"
        Height="720"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="0,0,0,33">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENÚ LATERAL -->
        <Border Grid.Column="0"
                Background="#173F5F" Margin="0,0,0,-28">

            <StackPanel Margin="25">

                <TextBlock Text="GESTIÓN"
                           Foreground="White"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="EMPRESARIAL"
                           Foreground="#4FD1C5"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,40"/>

                <TextBlock Text="OPERACIONES"
                           Foreground="#A0AEC0"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Button x:Name="btnIngresos"
                        Content="Ingresos"
                        Height="40"
                        Margin="0,0,0,8"
                        Click="BtnIngresos_Click"/>

                <Button Content="Salidas"
        Height="40"
        Margin="0,0,0,25"
        Click="BtnSalidas_Click"/>

                <TextBlock Text="MANTENIMIENTOS"
                           Foreground="#A0AEC0"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Button x:Name="btnConductores"
                        Content="Conductores"
                        Height="40"
                        Margin="0,0,0,8"
                        Click="BtnConductores_Click"/>

                <Button Content="Transportistas"
        Height="40"
        Margin="0,0,0,8"
        Click="BtnTransportistas_Click"/>

                <Button Content="Camiones"
        Height="40"
        Margin="0,0,0,8"
        Click="BtnCamiones_Click"/>

                <Button Content="Productos"
        Height="40"
        Margin="0,0,0,25"
        Click="BtnProductos_Click"/>

                <TextBlock Text="REPORTES"
                           Foreground="#A0AEC0"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Button Content="Cargas"
        Height="40"
        Margin="0,0,0,8"
        Click="BtnCargas_Click"/>

                <Button Content="Ingresos"
                        Height="40"
                        Margin="0,0,0,8"
                        Click="BtnReporteIngresos_Click"/>

                <Button Content="Salidas"
        Height="40"
        Click="BtnReporteSalidas_Click"/>

            </StackPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Column="1"
              Margin="45">

            <StackPanel>

                <TextBlock Text="Panel principal"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#173F5F"/>

                <TextBlock Text="Bienvenido al sistema de gestión empresarial"
                           FontSize="16"
                           Foreground="#718096"
                           Margin="0,8,0,35"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="25"
                            Margin="0,0,10,15">

                        <StackPanel>
                            <TextBlock Text="Ingresos"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#173F5F"/>

                            <TextBlock Text="Registro y control de ingresos de vehículos."
                                       Foreground="#718096"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="25"
                            Margin="10,0,0,15">

                        <StackPanel>
                            <TextBlock Text="Conductores"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#173F5F"/>

                            <TextBlock Text="Gestión de conductores y licencias."
                                       Foreground="#718096"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                    </Border>

                </Grid>

                <Border Background="#4FD1C5"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,10,0,0">

                    <StackPanel>
                        <TextBlock Text="Sistema listo"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Utiliza el menú lateral para acceder a cada módulo."
                                   Foreground="White"
                                   FontSize="14"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</Window>