<Window x:Class="Wpfseman2.SalidasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Salidas"
        Height="650"
        Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Registro de Salidas"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#173F5F"/>

            <TextBlock Text="Registra la información de salida del vehículo"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,30"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="30">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,15,20">

                        <TextBlock Text="Placa"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"/>

                        <TextBox x:Name="txtPlacaSalida"
                                 Height="38"
                                 Margin="0,7,0,20"/>

                        <TextBlock Text="Conductor"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"/>

                        <TextBox x:Name="txtConductorSalida"
                                 Height="38"
                                 Margin="0,7,0,20"/>

                        <TextBlock Text="Turno"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"/>

                        <ComboBox x:Name="cmbTurnoSalida"
                                  Height="38"
                                  Margin="0,7,0,20">

                            <ComboBoxItem Content="Mañana"/>
                            <ComboBoxItem Content="Tarde"/>
                            <ComboBoxItem Content="Noche"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="15,0,0,20">

                        <TextBlock Text="Fecha y Hora"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"/>

                        <DatePicker x:Name="dpFechaSalida"
                                    Height="38"
                                    Margin="0,7,0,20"/>

                        <TextBlock Text="Peso de Salida (kg)"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"/>

                        <TextBox x:Name="txtPesoSalida"
                                 Height="38"
                                 Margin="0,7,0,20"/>

                        <TextBlock Text="Observación"
                                   FontWeight="SemiBold"
                                   Foreground="#2D3748"/>

                        <TextBox x:Name="txtObservacion"
                                 Height="38"
                                 Margin="0,7,0,20"/>

                    </StackPanel>

                </Grid>

            </Border>

            <Button x:Name="btnRegistrarSalida"
                    Content="REGISTRAR SALIDA"
                    Height="45"
                    Width="220"
                    HorizontalAlignment="Right"
                    Margin="0,25,0,0"
                    Background="#4FD1C5"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnRegistrarSalida_Click"/>

        </StackPanel>

    </Grid>

</Window>