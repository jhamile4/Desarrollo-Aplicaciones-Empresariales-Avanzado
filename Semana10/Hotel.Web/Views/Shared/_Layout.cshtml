@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    string Activo(string c, string? a = null) =>
        controlador == c && (a == null || accion == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Hotel Aurora</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo"><i class="bi bi-buildings"></i></span>
                    <span>Hotel <strong>Aurora</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menú">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav ms-auto menu">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Home")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Habitaciones")" asp-controller="Habitaciones" asp-action="Index">
                                <i class="bi bi-door-open"></i> Habitaciones
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Reservas", "Disponibles")" asp-controller="Reservas" asp-action="Disponibles">
                                <i class="bi bi-calendar-check"></i> Disponibilidad
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controlador == "Reservas" && accion != "Disponibles" ? "active" : "")" asp-controller="Reservas" asp-action="Index">
                                <i class="bi bi-journal-bookmark"></i> Reservas
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @if (TempData["Exito"] is string exito)
        {
            <div class="alert alert-success alerta alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span>@exito</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alerta alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@error</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 Hotel Aurora · Semana 10</span>
            <span>ASP.NET Core MVC · EF Core Database First</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
