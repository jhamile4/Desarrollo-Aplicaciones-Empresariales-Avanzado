@model Habitacion
@{
    ViewData["Title"] = "Dar de baja habitación";
    var tipo = Model.IdTipoHabitacionNavigation;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card-soft text-center">
            <div class="card-body p-5">
                <div class="stat-icon ic-rose mx-auto mb-3" style="width:72px;height:72px;font-size:2rem">
                    <i class="bi bi-trash3"></i>
                </div>
                <h1 class="h3 fw-bold">¿Dar de baja la habitación @Model.Numero?</h1>
                <p class="text-suave">
                    Es una <strong>eliminación lógica</strong>: la habitación quedará con <code>Activo = 0</code>
                    y dejará de mostrarse, pero no se borra de la base de datos.
                </p>

                <div class="resumen justify-content-center my-4">
                    <span class="chip"><i class="bi bi-hash"></i> @Model.Numero</span>
                    <span class="chip"><i class="bi bi-layers"></i> Piso @Model.Piso</span>
                    <span class="chip"><i class="bi bi-tag"></i> @tipo.Nombre</span>
                    <span class="chip"><i class="bi bi-cash"></i> S/ @tipo.PrecioNoche.ToString("N2")</span>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.IdHabitacion" method="post" class="d-flex gap-2 justify-content-center">
                    <input type="hidden" asp-for="IdHabitacion" />
                    <a asp-action="Index" class="btn btn-ghost">No, volver</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sí, dar de baja</button>
                </form>
            </div>
        </div>
    </div>
</div>
