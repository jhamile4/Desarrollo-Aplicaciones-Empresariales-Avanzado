@model Habitacion
@{
    ViewData["Title"] = "Nueva habitación";
}

<div class="page-head">
    <div>
        <span class="eyebrow"><i class="bi bi-plus-circle"></i> Habitaciones</span>
        <h1>Nueva habitación</h1>
        <p>Registra una habitación y asígnale un tipo.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-soft">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <partial name="_Formulario" model="Model" />
                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
