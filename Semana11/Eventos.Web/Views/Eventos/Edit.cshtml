@model Evento
@{
    ViewData["Title"] = "Editar evento";
}

<div class="page-head">
    <div>
        <span class="eyebrow"><i class="bi bi-pencil"></i> Eventos</span>
        <h1>Editar evento</h1>
        <p>@Model.Titulo</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-soft">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <partial name="_Formulario" model="Model" />
                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
