@model Evento
@{
    ViewData["Title"] = "Dar de baja evento";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card-soft text-center">
            <div class="card-body p-5">
                <div class="stat-icon ic-rose mx-auto mb-3" style="width:72px;height:72px;font-size:2rem">
                    <i class="bi bi-trash3"></i>
                </div>
                <h1 class="h3 fw-bold">¿Dar de baja este evento?</h1>
                <p class="fw-semibold mb-1">@Model.Titulo</p>
                <p class="text-suave">
                    Es una <strong>eliminación lógica</strong>: el evento quedará con <code>Activo = false</code>
                    y dejará de mostrarse, pero no se borra de la base de datos.
                </p>

                <div class="resumen justify-content-center my-4">
                    <span class="chip"><i class="bi bi-clock"></i> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                    <span class="chip"><i class="bi bi-geo-alt"></i> @Model.Lugar</span>
                    <span class="chip"><i class="bi bi-tag"></i> @Model.Categoria?.Nombre</span>
                    <span class="chip"><i class="bi bi-people"></i> Aforo @Model.Aforo</span>
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center">
                    <a asp-action="Index" class="btn btn-ghost">No, volver</a>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sí, dar de baja</button>
                </form>
            </div>
        </div>
    </div>
</div>
