@model IEnumerable<Inscripcion>
@{
    ViewData["Title"] = "Inscripciones";
    string? estadoActual = ViewBag.Estado;
}

<div class="page-head">
    <div>
        <span class="eyebrow"><i class="bi bi-ticket-perforated"></i> Inscripciones</span>
        <h1>Inscripciones</h1>
        <p>Inscripciones con evento, asistente, fecha y estado.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nueva inscripción</a>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @(estadoActual == null ? "btn-primary" : "btn-ghost")">Todas</a>
    <a asp-action="Index" asp-route-estado="Confirmada" class="btn btn-sm @(estadoActual == "Confirmada" ? "btn-primary" : "btn-ghost")">Confirmadas</a>
    <a asp-action="Index" asp-route-estado="Cancelada" class="btn btn-sm @(estadoActual == "Cancelada" ? "btn-primary" : "btn-ghost")">Canceladas</a>
</div>

@if (!Model.Any())
{
    <div class="card-soft vacio">
        <i class="bi bi-inbox"></i>Todavía no hay inscripciones.
        <div class="mt-3"><a asp-action="Create" class="btn btn-primary btn-sm">Registrar la primera</a></div>
    </div>
}
else
{
    <div class="card-soft">
        <div class="table-responsive">
            <table class="table tabla">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Evento</th>
                        <th>Asistente</th>
                        <th>Fecha de inscripción</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td class="text-suave">@i.Id</td>
                            <td>
                                <div class="fw-bold">@i.Evento?.Titulo</div>
                                <div class="small text-suave"><i class="bi bi-clock"></i> @i.Evento?.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td>
                                <div class="fw-semibold">@i.Asistente?.Nombres</div>
                                <div class="small text-suave">DNI @i.Asistente?.Dni</div>
                            </td>
                            <td>@i.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="estado estado-@i.Estado">@i.Estado</span></td>
                            <td class="text-end">
                                @if (i.Estado == "Confirmada")
                                {
                                    <form asp-action="Cancelar" asp-route-id="@i.Id" method="post"
                                          onsubmit="return confirm('¿Cancelar la inscripción #@i.Id?');">
                                        <button type="submit" class="btn btn-sm btn-soft-danger">
                                            <i class="bi bi-x-circle"></i> Cancelar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
