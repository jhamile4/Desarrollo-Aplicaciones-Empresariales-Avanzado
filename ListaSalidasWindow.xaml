<Window x:Class="Wpfseman2.ListaSalidasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Salidas"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Reporte de Salidas"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#173F5F"/>

            <TextBlock Text="Consulta de salidas registradas"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,30"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25">

                <DataGrid x:Name="dgSalidas"
                          AutoGenerateColumns="False"
                          Height="420"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Placa"
                                            Binding="{Binding Placa}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Turno"
                                            Binding="{Binding Turno}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Conductor"
                                            Binding="{Binding Conductor}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Peso"
                                            Binding="{Binding Peso}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Observación"
                                            Binding="{Binding Observacion}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

        </StackPanel>

    </Grid>

</Window>
