<Window x:Class="Wpfseman2.ProductosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Productos"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Registro de Productos"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#173F5F"/>

            <TextBlock Text="Registra la información del producto"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,30"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="30">

                <StackPanel>

                    <TextBlock Text="Nombre del Producto"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtNombreProducto"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="Categoría"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtCategoria"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="Unidad de Medida"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtUnidad"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="Descripción"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtDescripcion"
                             Height="70"
                             Margin="0,8,0,20"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"/>

                    <Button x:Name="btnRegistrarProducto"
                            Content="REGISTRAR PRODUCTO"
                            Height="45"
                            Width="230"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Background="#4FD1C5"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnRegistrarProducto_Click"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </Grid>

</Window>