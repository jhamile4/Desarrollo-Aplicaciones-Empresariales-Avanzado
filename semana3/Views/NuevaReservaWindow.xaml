<Window x:Class="Semana3.Views.NuevaReservaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Reserva" Height="400" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Registrar Nueva Reserva" FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,15" Grid.Row="0"/>

        <TextBlock Text="Aula:" Grid.Row="1" Margin="0,5"/>
        <ComboBox x:Name="cbAulas" Grid.Row="1" Height="28" Margin="0,25,0,0"
                  DisplayMemberPath="Nombre" SelectedValuePath="AulaId"/>

        <TextBlock Text="Fecha (aaaa-mm-dd):" Grid.Row="2" Margin="0,5"/>
        <TextBox x:Name="txtFecha" Grid.Row="2" Height="28" Margin="0,25,0,0"/>

        <TextBlock Text="Hora (hh:mm):" Grid.Row="3" Margin="0,5"/>
        <TextBox x:Name="txtHora" Grid.Row="3" Height="28" Margin="0,25,0,0"/>

        <TextBlock Text="Motivo:" Grid.Row="4" Margin="0,5"/>
        <TextBox x:Name="txtMotivo" Grid.Row="4" Height="28" Margin="0,25,0,0"/>

        <Button Content="Guardar Reserva" Grid.Row="5" Height="35" Margin="0,20,0,0"
                Click="BtnGuardar_Click"/>

        <TextBlock x:Name="txtMensaje" Grid.Row="6" Foreground="Red"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>