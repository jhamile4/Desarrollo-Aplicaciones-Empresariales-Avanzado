<Window x:Class="Semana3.Views.ReservasDataTableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservas (DataTable)" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Lista de Reservas (modo desconectado - DataTable)"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Grid.Row="0"/>

        <DataGrid x:Name="dgReservas" Grid.Row="1" AutoGenerateColumns="True"
                  IsReadOnly="True"/>
    </Grid>
</Window>