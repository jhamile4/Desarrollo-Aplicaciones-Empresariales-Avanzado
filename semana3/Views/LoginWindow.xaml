<Window x:Class="Semana3.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login - Sistema de Reservas" Height="300" Width="400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Iniciar Sesión" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="0"/>

        <TextBlock Text="Usuario:" Grid.Row="1" Margin="0,5"/>
        <TextBox x:Name="txtUsuario" Grid.Row="1" Height="30" Margin="0,30,0,0"/>

        <TextBlock Text="Contraseña:" Grid.Row="2" Margin="0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="2" Height="30" Margin="0,30,0,0"/>

        <Button x:Name="btnIngresar" Content="Ingresar" Grid.Row="3"
                Height="35" Margin="0,20,0,0" Click="btnIngresar_Click"/>

        <TextBlock x:Name="txtError" Foreground="Red" Grid.Row="4"
                   HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
