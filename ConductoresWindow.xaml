<Window x:Class="Wpfseman2.ConductoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Conductores"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid Margin="40">

        <StackPanel>

            <TextBlock Text="Registro de Conductores"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#173F5F"/>

            <TextBlock Text="Registra la información del conductor"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,30"/>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="30">

                <StackPanel>

                    <TextBlock Text="Nombre del Conductor"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtNombreConductor"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="Licencia"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtLicencia"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <TextBlock Text="Transporte"
                               FontWeight="SemiBold"
                               Foreground="#2D3748"/>

                    <TextBox x:Name="txtTransporte"
                             Height="40"
                             Margin="0,8,0,20"
                             FontSize="14"/>

                    <Button x:Name="btnRegistrarConductor"
                            Content="REGISTRAR CONDUCTOR"
                            Height="45"
                            Width="220"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Background="#4FD1C5"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnRegistrarConductor_Click"/>

                    <Button x:Name="btnVerConductores"
                            Content="VER CONDUCTORES"
                            Height="45"
                            Width="220"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0"
                            Background="#173F5F"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnVerConductores_Click"/>
                </StackPanel>


            </Border>

        </StackPanel>

    </Grid>

</Window>