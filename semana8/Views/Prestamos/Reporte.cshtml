@model IEnumerable<Biblioteca.Web.Models.PrestamoReporte>

@{
    var desde = ViewData["Desde"]?.ToString();
    var hasta = ViewData["Hasta"]?.ToString();
}

<div class="card card-custom p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary m-0 fw-bold"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reporte de Préstamos por Fechas</h2>
            <small class="text-muted">Consulta de préstamos realizados entre intervalos de tiempo</small>
        </div>
    </div>

    <!-- Formulario de filtro por fechas -->
    <form method="get" asp-action="Reporte" class="row g-3 mb-4 bg-light p-3 rounded border">
        <div class="col-md-4">
            <label class="form-label fw-bold"><i class="bi bi-calendar-event me-1"></i>Fecha Desde:</label>
            <input type="date" name="desde" value="@desde" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold"><i class="bi bi-calendar-check me-1"></i>Fecha Hasta:</label>
            <input type="date" name="hasta" value="@hasta" class="form-control" />
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary fw-bold w-100">
                <i class="bi bi-filter me-1"></i> Filtrar Reporte
            </button>
            @if (!string.IsNullOrEmpty(desde) || !string.IsNullOrEmpty(hasta))
            {
                <a asp-action="Reporte" class="btn btn-outline-secondary" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center my-3">
            <i class="bi bi-info-circle me-2"></i> No se registraron préstamos en el rango de fechas seleccionado.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-bordered shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Socio</th>
                        <th style="width: 120px;">DNI Socio</th>
                        <th>Libro Solicitado</th>
                        <th class="text-center" style="width: 140px;">Fecha Préstamo</th>
                        <th class="text-center" style="width: 140px;">Fecha Límite</th>
                        <th class="text-center" style="width: 120px;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var badgeClass = p.Estado == "Vencido" ? "bg-danger" : (p.Estado == "Devuelto" ? "bg-success" : "bg-primary");
                        <tr>
                            <td class="fw-bold">#@p.PrestamoId</td>
                            <td class="fw-bold text-dark">@p.SocioNombre</td>
                            <td><span class="badge bg-secondary font-monospace">@p.SocioDNI</span></td>
                            <td class="text-primary fw-bold">@p.LibroTitulo</td>
                            <td class="text-center">@p.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@p.FechaLimite.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <span class="badge @badgeClass">@p.Estado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
