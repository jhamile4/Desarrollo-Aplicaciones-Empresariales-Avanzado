@model Biblioteca.Web.Models.Libro

<div class="card card-custom p-4 mx-auto" style="max-width: 650px;">
    <h3 class="text-warning text-dark fw-bold mb-3"><i class="bi bi-pencil-square me-2"></i>Editar Libro</h3>
    <p class="text-muted small">Modifique la información del libro registrado en la base de datos.</p>
    <hr />

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="LibroId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label fw-bold"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AutorId" class="form-label fw-bold"></label>
            <select asp-for="AutorId" asp-items="@((SelectList)ViewData["Autores"]!)" class="form-select">
                <option value="">-- Seleccione un Autor --</option>
            </select>
            <span asp-validation-for="AutorId" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Ejemplares" class="form-label fw-bold"></label>
                <input asp-for="Ejemplares" class="form-control" type="number" min="1" max="1000" />
                <span asp-validation-for="Ejemplares" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Precio" class="form-label fw-bold"></label>
                <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="FechaPublicacion" class="form-label fw-bold"></label>
            <input asp-for="FechaPublicacion" class="form-control" type="date" />
            <span asp-validation-for="FechaPublicacion" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-warning fw-bold text-dark">
                <i class="bi bi-save me-1"></i> Actualizar Libro
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
