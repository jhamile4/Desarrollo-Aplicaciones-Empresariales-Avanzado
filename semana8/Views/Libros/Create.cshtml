@model Biblioteca.Web.Models.Libro

<div class="card card-custom p-4 mx-auto" style="max-width: 650px;">
    <h3 class="text-success fw-bold mb-3"><i class="bi bi-journal-plus me-2"></i>Registrar Nuevo Libro</h3>
    <p class="text-muted small">Complete todos los campos requeridos para ingresar un libro al catálogo de la biblioteca.</p>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Titulo" class="form-label fw-bold"></label>
            <input asp-for="Titulo" class="form-control" placeholder="Ej: Cien años de soledad" />
            <span asp-validation-for="Titulo" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AutorId" class="form-label fw-bold"></label>
            <select asp-for="AutorId" asp-items="@((SelectList)ViewData["Autores"]!)" class="form-select">
                <option value="">-- Seleccione un Autor --</option>
            </select>
            <span asp-validation-for="AutorId" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ISBN" class="form-label fw-bold"></label>
                <input asp-for="ISBN" class="form-control" placeholder="Ej: 978-0-00-000001" />
                <span asp-validation-for="ISBN" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Ejemplares" class="form-label fw-bold"></label>
                <input asp-for="Ejemplares" class="form-control" type="number" min="0" max="1000" />
                <span asp-validation-for="Ejemplares" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-success fw-bold">
                <i class="bi bi-check-circle me-1"></i> Guardar Libro
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
