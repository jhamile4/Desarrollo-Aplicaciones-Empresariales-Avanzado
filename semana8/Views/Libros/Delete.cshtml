@model Biblioteca.Web.Models.Libro

<div class="card card-custom p-4 border-danger mx-auto" style="max-width: 650px;">
    <div class="border-bottom border-danger pb-3 mb-3">
        <h3 class="text-danger fw-bold m-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación Lógica</h3>
        <small class="text-muted">El registro no será borrado de la base de datos, sino que pasará a estado inactivo (Activo = 0).</small>
    </div>

    <div class="alert alert-warning" role="alert">
        <strong>¿Está seguro de que desea desactivar este libro?</strong>
    </div>

    <dl class="row fs-6">
        <dt class="col-sm-4 text-muted">ID Libro:</dt>
        <dd class="col-sm-8 fw-bold">#@Model.LibroId</dd>

        <dt class="col-sm-4 text-muted">Título:</dt>
        <dd class="col-sm-8 text-primary fw-bold">@Model.Titulo</dd>

        <dt class="col-sm-4 text-muted">Autor:</dt>
        <dd class="col-sm-8"><span class="badge bg-secondary">@(Model.AutorNombre ?? "Sin Autor")</span></dd>

        <dt class="col-sm-4 text-muted">Ejemplares:</dt>
        <dd class="col-sm-8">@Model.Ejemplares u.</dd>

        <dt class="col-sm-4 text-muted">Precio:</dt>
        <dd class="col-sm-8">@(Model.Precio.HasValue ? Model.Precio.Value.ToString("C2") : "N/A")</dd>
    </dl>

    <form asp-action="Delete" method="post" class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
        <input type="hidden" asp-for="LibroId" />
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-x-circle me-1"></i> Cancelar
        </a>
        <button type="submit" class="btn btn-danger fw-bold">
            <i class="bi bi-trash-fill me-1"></i> Confirmar Desactivación
        </button>
    </form>
</div>
