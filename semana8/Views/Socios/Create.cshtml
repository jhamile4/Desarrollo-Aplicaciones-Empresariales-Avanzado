@model Biblioteca.Web.Models.Socio

<div class="card card-custom p-4 mx-auto" style="max-width: 650px;">
    <h3 class="text-success fw-bold mb-3"><i class="bi bi-person-plus-fill me-2"></i>Registrar Nuevo Socio</h3>
    <p class="text-muted small">Ingrese los datos del socio. Recuerde que el DNI debe ser único.</p>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Nombre" class="form-label fw-bold"></label>
            <input asp-for="Nombre" class="form-control" placeholder="Ej: Juan Pérez Gómez" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DNI" class="form-label fw-bold"></label>
            <input asp-for="DNI" class="form-control" placeholder="Ej: 72345678" />
            <span asp-validation-for="DNI" class="text-danger fw-bold small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label fw-bold"></label>
            <input asp-for="Email" class="form-control" type="email" placeholder="Ej: juan.perez@email.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Telefono" class="form-label fw-bold"></label>
            <input asp-for="Telefono" class="form-control" placeholder="Ej: 987654321" />
            <span asp-validation-for="Telefono" class="text-danger small"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-success fw-bold">
                <i class="bi bi-check-circle me-1"></i> Registrar Socio
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
