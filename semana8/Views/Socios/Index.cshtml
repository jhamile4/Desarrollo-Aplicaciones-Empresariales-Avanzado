@model IEnumerable<Biblioteca.Web.Models.Socio>

<div class="card card-custom p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-primary m-0 fw-bold"><i class="bi bi-people-fill me-2"></i>Listado de Socios Activos</h2>
            <small class="text-muted">Socios registrados para el servicio de préstamos</small>
        </div>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Registrar Socio
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center my-3">
            <i class="bi bi-info-circle me-2"></i> No hay socios activos registrados actualmente.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-bordered shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">ID</th>
                        <th>Nombre Completo</th>
                        <th style="width: 140px;">DNI</th>
                        <th>Correo Electrónico</th>
                        <th style="width: 150px;">Teléfono</th>
                        <th class="text-center" style="width: 100px;">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var socio in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@socio.SocioId</td>
                            <td class="fw-bold text-dark">@socio.Nombre</td>
                            <td><span class="badge bg-secondary font-monospace fs-6">@socio.DNI</span></td>
                            <td>@(string.IsNullOrEmpty(socio.Email) ? "-" : socio.Email)</td>
                            <td>@(string.IsNullOrEmpty(socio.Telefono) ? "-" : socio.Telefono)</td>
                            <td class="text-center">
                                <span class="badge bg-success">Activo</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
